<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Package dependencies: ranges keep the package on a single Umbraco major -->
  <ItemGroup>
    <PackageVersion Include="Umbraco.Cms.Api.Delivery" Version="[18.0.0, 19.0.0)" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="[18.0.0, 19.0.0)" />
    <PackageVersion Include="Umbraco.Cms.Web.Website" Version="[18.0.0, 19.0.0)" />
  </ItemGroup>

  <!-- Test site -->
  <ItemGroup>
    <PackageVersion Include="Umbraco.Cms" Version="18.3.0" />
    <PackageVersion Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
  </ItemGroup>

</Project>
