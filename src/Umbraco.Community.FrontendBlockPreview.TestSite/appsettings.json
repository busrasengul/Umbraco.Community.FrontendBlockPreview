{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "b5d6a3c1-4f2e-4d8a-9c7b-1e2f3a4b5c6d",
        "SanitizeTinyMce": true
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true
      },
      "ModelsBuilder": {
        "ModelsMode": "Nothing"
      },
      "DeliveryApi": {
        "Enabled": true
      }
    }
  },
  "FrontendBlockPreview": {
    "Renderer": "Razor",
    "DefaultFrontendUrl": "http://localhost:5173",
    "Razor": {
      "Stylesheets": [
        "/css/site.css"
      ]
    }
  }
}